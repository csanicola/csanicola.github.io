---
layout: default
---
<div class="post">
  <header class="post-header">
    {% if page.type == 'categories' %}
      <h1 class="post-title"><i class="fa-solid fa-tag fa-sm"></i> {{ page.title }}</h1>
      <p class="post-description">an archive of {{ page.collection_name }} in this category</p>
    {% elsif page.type == 'year' %}
      {% comment %}Define the year once from the archive page’s own date{% endcomment %}
      {% assign archive_year = page.date | date: '%Y' %}
      <h1 class="post-title"><i class="fa-solid fa-calendar fa-sm"></i> {{ archive_year }}</h1>
      <p class="post-description">an archive of {{ page.collection_name }} from this year</p>
    {% elsif page.type == 'tags' %}
      <h1 class="post-title"><i class="fa-solid fa-hashtag fa-sm"></i> {{ page.title }}</h1>
      <p class="post-description">an archive of {{ page.collection_name }} with this tag</p>
    {% endif %}
  </header>

  <article class="archive">
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% if page.type == 'year' %}
          {% comment %}
            Filter and sort the documents for this year using 'started' date.
            Only books with a started date that matches the archive year will appear.
          {% endcomment %}
          {% assign year_docs = page.documents
            | where_exp: "doc", "doc.started"
            | where_exp: "doc", "doc.started | date: '%Y' == archive_year"
            | sort: "started" | reverse %}
          {% for document in year_docs %}
            <tr>
              <th scope="row">{{ document.started | date: '%b %d, %Y' }}</th>
              <td>
                {% if document.redirect == blank %}
                  <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
                {% elsif document.redirect contains '://' %}
                  <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
                {% else %}
                  <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% else %}
          {% comment %}For categories and tags, keep the original behaviour{% endcomment %}
          {% for document in page.documents %}
            <tr>
              <th scope="row">{{ document.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if document.redirect == blank %}
                  <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
                {% elsif document.redirect contains '://' %}
                  <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
                {% else %}
                  <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% endif %}
      </table>
    </div>
  </article>
</div>